# Managed by Ansible. Local edits are overwritten on the next run.
SENSOR_ID={{ sensor_id | default(inventory_hostname) }}
CAPTURE_BUCKET={{ capture_bucket | default('') }}
AWS_DEFAULT_REGION={{ aws_region | default('us-east-1') }}
CAPTURE_INTERFACE={{ capture_interface | default(ansible_default_ipv4.interface) }}
CAPTURE_DIR={{ capture_dir }}
OUTPUT_DIR={{ extracted_dir }}
ROTATE_SECONDS={{ rotate_seconds | default(900) }}
ROTATE_SIZE_MB={{ rotate_size_mb | default(256) }}
LOGSTASH_HOST={{ logstash_host | default('127.0.0.1') }}
LOGSTASH_PORT={{ logstash_port | default(5400) }}
POLL_INTERVAL={{ poll_interval | default(60) }}
