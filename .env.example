# Copy to .env before running the stack locally.
# The deployed sensors read these values from /etc/deception-shield/sensor.env,
# which Ansible renders; this file covers the workstation case.

# Identifies the sensor in every document it produces.
SENSOR_ID=local-sensor

# Interface the capture and Suricata attach to.
CAPTURE_INTERFACE=eth0

# Where captures are written and where the extractor looks for them.
CAPTURE_DIR=./data

# Rotation. Captures close on whichever limit is reached first.
ROTATE_SECONDS=900
ROTATE_SIZE_MB=256

# Elasticsearch and Logstash heap. Elasticsearch should get no more than half
# the host memory, and leaving it below 32g keeps compressed object pointers.
ES_HEAP=2g
LS_HEAP=1g

# Where the extractor ships records. On a sensor this is the host gateway,
# because the extractor runs in a container and Logstash binds to loopback.
LOGSTASH_HOST=host.docker.internal

# Public URL Kibana advertises to browsers.
KIBANA_BASE_URL=http://localhost:5601

# Archive destination. Leave empty to keep captures on the local volume.
CAPTURE_BUCKET=
AWS_DEFAULT_REGION=us-east-1
