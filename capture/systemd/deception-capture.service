[Unit]
Description=Deception Shield packet capture
Documentation=https://github.com/DLtxt/deception-shield
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=-/etc/deception-shield/sensor.env
ExecStart=/usr/local/bin/capture.sh
Restart=always
RestartSec=10

# Capture needs the raw socket capabilities and nothing else.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/pcap
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
